{
  "version": 2,
  "builds": [
    {
      "src": "src/bot.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**/*"],
        "buildCommand": "npm run build",
        "nodeVersion": "18.x"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/bot.ts"
    }
  ]
} 