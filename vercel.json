{
  "version": 2,
  "builds": [
    {
      "src": "src/bot.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**/*"],
        "buildCommand": "npm run build:bot",
        "nodeVersion": "22.x"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/bot.ts"
    }
  ]
} 